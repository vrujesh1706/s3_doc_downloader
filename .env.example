PROD_DB_USER=replace_me
PROD_DB_PASSWORD=replace_me
PROD_DB_HOST=replace_me
PROD_DB_PORT=3306
PROD_DB_SSL=true
PROD_S3_BUCKET=ezdi-production-bucket

STAGING_DB_USER=replace_me
STAGING_DB_PASSWORD=replace_me
STAGING_DB_HOST=replace_me
STAGING_DB_PORT=3306
STAGING_DB_SSL=true
STAGING_S3_BUCKET=ezdi-staging-bucket

# commonDb -- holds the overall_data metadata table used to find encounters.
# One shared company server, so it has no production/staging split.
COMMON_DB_HOST=replace_me
COMMON_DB_PORT=3306
COMMON_DB_USER=replace_me
COMMON_DB_PASSWORD=replace_me
COMMON_DB_NAME=CAPC_ENCOUNTER_ACCURACY_REPORT

AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=us-east-1

# Optional safety defaults
MAX_SEARCH_ROWS=5000
MAX_DOWNLOAD_FILES=2500
# Aggregate uncompressed S3 bytes per job (1 GiB).
MAX_DOWNLOAD_BYTES=1073741824
# Includes running jobs and completed downloads waiting to be fetched.
MAX_DOWNLOAD_JOBS=2
DOWNLOAD_JOB_TTL_SECONDS=3600
